#
# Copy this file to `.env` and fill in your key. NEVER commit `.env` (it is gitignored).
# The Anthropic API key lives ONLY here on the server — never in the browser or the repo.

# Required: your Anthropic API key (format: sk-ant-...). Server-side only.
ANTHROPIC_API_KEY=

# Optional: port for the proxy (default 8787).
PORT=8787

# Optional: CORS allow-origin for the browser app (default "*"). In production set this to
# your site's exact origin, e.g. https://clsoftlab-lang.github.io
ALLOWED_ORIGIN=*
